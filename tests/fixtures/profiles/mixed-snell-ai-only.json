{
  "log": {
    "disabled": false,
    "level": "info",
    "timestamp": true
  },
  "ntp": {
    "enabled": true,
    "interval": "30m",
    "server": "time.apple.com",
    "server_port": 123,
    "detour": "direct"
  },
  "outbounds": [
    {
      "type": "snell",
      "tag": "proxy",
      "server": "8.8.8.8",
      "server_port": 10443,
      "version": 6,
      "psk": "synthetic-shared-snell-psk",
      "userkey": "synthetic-snell-alice",
      "mode": "default",
      "reuse": false,
      "domain_resolver": {
        "server": "google"
      }
    },
    {
      "type": "direct",
      "tag": "direct",
      "domain_resolver": {
        "server": "system"
      }
    }
  ],
  "http_clients": [
    {
      "tag": "rule-downloads",
      "detour": "proxy"
    }
  ],
  "inbounds": [
    {
      "type": "mixed",
      "listen": "127.0.0.1",
      "listen_port": 1080,
      "set_system_proxy": false
    }
  ],
  "route": {
    "rule_set": [
      {
        "type": "remote",
        "format": "binary",
        "tag": "AdGuard-DNS-Filter",
        "url": "https://raw.githubusercontent.com/Dreista/sing-box-rule-set-cn/rule-set/filter.txt.srs",
        "update_interval": "1d",
        "http_client": "rule-downloads",
        "initial_path": "rules/be923102d393b70598cc08a57abdde878aae666c9c5116a56da8167a9728b777.srs"
      },
      {
        "format": "binary",
        "tag": "AI-Anthropic",
        "type": "remote",
        "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/anthropic.srs",
        "http_client": "rule-downloads",
        "update_interval": "1d",
        "initial_path": "rules/8f8c33ffe1d8831043298dc039861d8f505b4c74a265de95e94ceaeb106ea1ae.srs"
      },
      {
        "format": "binary",
        "tag": "AI-Geosite",
        "type": "remote",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-category-ai-!cn.srs",
        "http_client": "rule-downloads",
        "update_interval": "1d",
        "initial_path": "rules/26532516f1b4f6ca8f95a66fa62cb27808eecbabebd8aee1b7c533335a734b60.srs"
      }
    ],
    "default_http_client": "rule-downloads",
    "rules": [
      {
        "action": "sniff"
      },
      {
        "ip_is_private": true,
        "outbound": "direct"
      },
      {
        "action": "hijack-dns",
        "mode": "or",
        "rules": [
          {
            "protocol": "dns"
          },
          {
            "port": 53
          }
        ],
        "type": "logical"
      },
      {
        "action": "reject",
        "mode": "or",
        "rules": [
          {
            "port": 853
          },
          {
            "network": "udp",
            "port": 443
          },
          {
            "protocol": "stun"
          }
        ],
        "type": "logical"
      },
      {
        "domain": ["vpn.example.com"],
        "domain_suffix": ["portal.example.net"],
        "outbound": "direct"
      },
      {
        "outbound": "proxy",
        "rule_set": ["AI-Anthropic", "AI-Geosite"]
      },
      {
        "action": "reject",
        "rule_set": ["AdGuard-DNS-Filter"]
      },
      {
        "clash_mode": "Direct",
        "outbound": "direct"
      },
      {
        "clash_mode": "Global",
        "outbound": "proxy"
      }
    ],
    "final": "direct"
  },
  "dns": {
    "optimistic": false,
    "servers": [
      {
        "detour": "proxy",
        "server": "8.8.8.8",
        "tag": "google",
        "type": "tls"
      },
      {
        "server": "127.0.0.53",
        "tag": "system",
        "type": "udp"
      }
    ],
    "rules": [
      {
        "domain": ["vpn.example.com"],
        "domain_suffix": ["portal.example.net"],
        "server": "system"
      },
      {
        "rule_set": ["AI-Anthropic", "AI-Geosite"],
        "server": "google"
      }
    ],
    "final": "system"
  },
  "experimental": {
    "cache_file": {
      "enabled": true,
      "store_dns": true,
      "path": "cache-snell-ai-only.db"
    }
  }
}
