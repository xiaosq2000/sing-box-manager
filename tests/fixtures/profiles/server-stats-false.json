{
  "dns": {
    "servers": [{ "type": "local", "tag": "server-local" }]
  },
  "inbounds": [
    {
      "listen": "::",
      "listen_port": 8443,
      "multiplex": {
        "enabled": true
      },
      "tag": "trojan",
      "tls": {
        "certificate_path": "/etc/letsencrypt/live/vpn.example.com/fullchain.pem",
        "enabled": true,
        "key_path": "/etc/letsencrypt/live/vpn.example.com/privkey.pem",
        "server_name": "vpn.example.com"
      },
      "type": "trojan",
      "users": [
        {
          "name": "trojan:alice",
          "password": "change-me"
        }
      ]
    },
    {
      "listen": "::",
      "listen_port": 58080,
      "obfs": {
        "password": "change-me-obfs",
        "type": "salamander"
      },
      "tag": "hysteria2",
      "tls": {
        "certificate_path": "/etc/letsencrypt/live/vpn.example.com/fullchain.pem",
        "enabled": true,
        "key_path": "/etc/letsencrypt/live/vpn.example.com/privkey.pem",
        "server_name": "vpn.example.com"
      },
      "type": "hysteria2",
      "users": [
        {
          "name": "hysteria2:alice",
          "password": "change-me"
        }
      ]
    },
    {
      "listen": "::",
      "listen_port": 9443,
      "network": "tcp",
      "tag": "naive",
      "tls": {
        "certificate_path": "/etc/letsencrypt/live/vpn.example.com/fullchain.pem",
        "enabled": true,
        "key_path": "/etc/letsencrypt/live/vpn.example.com/privkey.pem",
        "server_name": "vpn.example.com"
      },
      "type": "naive",
      "users": [
        {
          "password": "change-me",
          "username": "alice"
        }
      ]
    }
  ],
  "log": {
    "disabled": false,
    "level": "info",
    "timestamp": true
  },
  "outbounds": [{ "type": "direct", "tag": "direct" }],
  "route": {
    "final": "direct",
    "rules": [
      { "action": "resolve", "server": "server-local" },
      { "network": "udp", "action": "route-options", "udp_connect": true },
      { "ip_is_private": true, "action": "reject" },
      {
        "ip_cidr": [
          "0.0.0.0/8",
          "100.64.0.0/10",
          "240.0.0.0/4",
          "::ffff:0:0/104",
          "::ffff:6440:0/106",
          "::ffff:f000:0/100"
        ],
        "action": "reject"
      }
    ]
  }
}
