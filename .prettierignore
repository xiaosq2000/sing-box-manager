# Tool-owned files. Each is rewritten by the tool that generates it, in that
# tool's own style, so formatting them here only makes `--check` fail after the
# next regeneration.

# Regenerated by pixi whenever the environment changes.
pixi.lock

# Rewritten by sops on every edit, with its own indentation.
config/inventory/*.sops.yaml

# Prettier's HTML parser cannot preserve Django template tags or attributes.
sing_box_manager/control_plane/templates/
