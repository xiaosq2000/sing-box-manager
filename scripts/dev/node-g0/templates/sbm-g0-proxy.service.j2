[Unit]
Description=Disposable G0 sing-box fixture
ConditionPathExists=/etc/sbm-node-g0-disposable

[Service]
Type=simple
ExecStart=/opt/sbm-node-g0/sing-box run -D /var/lib/sbm-node-g0 -c /var/lib/sbm-node-g0/current/config.json
Restart=on-failure
RestartSec=1
TimeoutStopSec=10
KillMode=control-group
UMask=0077
