[Unit]
Description=Disposable G0 sing-box fixture
ConditionPathExists=/etc/sbm-node-g0-disposable

[Service]
Type=simple
ExecStart=/opt/sbm-node-g0/sbm-node-g0 exec --identity /etc/sbm-node-g0/identity.json --state /var/lib/sbm-node-g0 --engine /opt/sbm-node-g0/sing-box
Restart=on-failure
RestartSec=1
TimeoutStopSec=10
KillMode=control-group
UMask=0077
