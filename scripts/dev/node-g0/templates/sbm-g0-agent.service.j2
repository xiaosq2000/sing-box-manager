[Unit]
Description=Disposable G0 node-agent feasibility fixture
After=network.target
ConditionPathExists=/etc/sbm-node-g0-disposable

[Service]
Type=simple
ExecStart=/opt/sbm-node-g0/sbm-node-g0 run --identity /etc/sbm-node-g0/identity.json --state /var/lib/sbm-node-g0 --engine /opt/sbm-node-g0/sing-box
Restart=on-failure
RestartSec=1
UMask=0077

[Install]
WantedBy=multi-user.target
