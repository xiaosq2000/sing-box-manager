[Unit]
Description=sing-box-manager traffic stats collector
After=network-online.target sing-box.service
Wants=network-online.target

[Service]
Type=oneshot
User=sbm
Group=sbm
WorkingDirectory=/opt/sing-box-manager
StateDirectory=sing-box-manager
StateDirectoryMode=0750
ExecStart=/opt/sing-box-manager/.pixi/envs/default/bin/python -m sing_box_manager --config config/inventory/runtime.yaml stats-collect
Environment=PYTHONUNBUFFERED=1
